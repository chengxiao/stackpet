+bool CustomWakeWord::InitializeAfe() {
+    // Same front-end as AfeWakeWord: microphone channels first, then the speaker reference channel
+    int ref_num = codec_->input_reference() ? 1 : 0;
+    std::string input_format;
+    for (int i = 0; i < codec_->input_channels() - ref_num; i++) {
+        input_format.push_back('M');
+    }
+    for (int i = 0; i < ref_num; i++) {
+        input_format.push_back('R');
+    }
+
+    afe_config_t* afe_config = afe_config_init(input_format.c_str(), models_, AFE_TYPE_SR, AFE_MODE_HIGH_PERF);
+    if (afe_config == nullptr) {
+        ESP_LOGE(TAG, "Failed to create the AFE config");
+        return false;
+    }
+    // No WakeNet: MultiNet is the wake word engine here
+    afe_config->wakenet_init = false;
+    afe_config->wakenet_model_name = nullptr;
+    afe_config->wakenet_model_name_2 = nullptr;
+    // Cancel the robot's own speaker output (AI voice, sound effects, music) using the reference channel
+    afe_config->aec_init = codec_->input_reference();
+    afe_config->aec_mode = AEC_MODE_SR_HIGH_PERF;
+    // VAD gates MultiNet (see the task layout comment). Mode 1 let steady room noise (TV, music) count as speech
+    // ~60% of the time and kept MultiNet saturated, hence the stricter mode 3. The AFE pre-roll cache
+    // (vad_delay_ms) restores the frames buffered before speech was confirmed, so the first syllable is kept.
+    afe_config->vad_init = true;
+    afe_config->vad_mode = VAD_MODE_3;
+    afe_config->vad_min_speech_ms = 96;
+    afe_config->vad_min_noise_ms = 256;
+    afe_config->afe_perferred_core = kAfeTaskCore;
+    afe_config->afe_perferred_priority = kAfeTaskPriority;
+    afe_config->memory_alloc_mode = AFE_MEMORY_ALLOC_MORE_PSRAM;
+    // Noise suppression / AGC keep the ESP-SR speech recognition defaults (AFE_TYPE_SR is tuned for
+    // recognition and leaves out the nonlinear suppression used for voice calls)
+    afe_config = afe_config_check(afe_config);
+
+    afe_iface_ = esp_afe_handle_from_config(afe_config);
+    afe_data_ = afe_iface_ != nullptr ? afe_iface_->create_from_config(afe_config) : nullptr;
+    if (afe_data_ == nullptr) {
+        ESP_LOGE(TAG, "Failed to create the AFE");
+        afe_config_free(afe_config);
