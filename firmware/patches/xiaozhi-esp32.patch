+void CustomWakeWord::QueueSpeech(const int16_t* samples, size_t count, bool end_of_segment) {
+    // Only called by the fetch task: pending_samples_ needs no lock
+    pending_samples_.insert(pending_samples_.end(), samples, samples + count);
+    size_t dropped = 0;
+    const uint32_t generation = generation_.load();
+    {
+        std::lock_guard<std::mutex> lock(speech_mutex_);
+        while (pending_samples_.size() >= (size_t)mn_chunk_) {
+            SpeechChunk chunk;
+            chunk.pcm.assign(pending_samples_.begin(), pending_samples_.begin() + mn_chunk_);
+            chunk.generation = generation;
+            pending_samples_.erase(pending_samples_.begin(), pending_samples_.begin() + mn_chunk_);
+            speech_queue_.push_back(std::move(chunk));
+        }
+        if (end_of_segment) {
+            // Drop the partial tail (< 32 ms of trailing silence) and close the utterance
+            pending_samples_.clear();
+            if (!speech_queue_.empty()) {
+                speech_queue_.back().end_of_segment = true;
+            }
+        }
+        // Bound the latency: MultiNet is slower than real time, never let it fall more than ~3 s behind.
+        // Trim with hysteresis (down to the newest kTrimQueuedChunks) and reset MultiNet once: dropping one
+        // chunk per fetch and resetting each time would leave MultiNet unable to ever hear a whole phrase.
+        if (speech_queue_.size() > kMaxQueuedChunks) {
+            dropped = speech_queue_.size() - kTrimQueuedChunks;
+            speech_queue_.erase(speech_queue_.begin(), speech_queue_.begin() + dropped);
+        }
+    }
+    if (dropped > 0) {
+        clean_multinet_ = true;
+        dropped_since_log_ += dropped;
+    }
+    int64_t now = esp_timer_get_time();
+    if (dropped_since_log_ > 0 && now - last_drop_log_us_ >= 1000 * 1000) {
+        ESP_LOGW(TAG, "MultiNet backlog full, dropped %d chunk(s) of speech", (int)dropped_since_log_);
+        dropped_since_log_ = 0;
+        last_drop_log_us_  = now;
+    }
+    xSemaphoreGive(speech_signal_);
 }
 
