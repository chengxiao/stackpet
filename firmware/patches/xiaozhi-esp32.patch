+#define DETECTION_RUNNING_EVENT     (1 << 0)
+#define DETECTION_EXIT_EVENT        (1 << 1)
+#define FETCH_TASK_EXITED_EVENT     (1 << 2)
+#define RECOGNIZE_TASK_EXITED_EVENT (1 << 3)
+
+// Task layout (measured on the CoreS3: quad PSRAM shared with flash, 32 KB data cache, ~40 KB free SRAM):
+// - MultiNet7 needs ~47 ms of CPU per 32 ms chunk here (ESP-SR benchmark: 11 ms), even alone on a core, so it
+//   cannot run continuously in real time. Fed directly, it let the AFE feed ring buffer overflow
+//   ("Ringbuffer of AFE(FEED) is full") and starved IDLE0 (task watchdog).
+// - So the AFE also runs VAD. The fetch task (cheap) drains the AFE in real time and queues only speech
+//   segments, including the AFE's pre-roll cache and a short tail. The recognize task runs MultiNet on the
+//   queued speech at the lowest priority on core 0 and yields regularly, catching up after each utterance.
+// - The AFE (AEC + VAD) task and the fetch task stay on core 1 above LVGL (priority 3), so they never starve.
+static constexpr uint32_t kFetchTaskStackSize = 4096;
+static constexpr UBaseType_t kFetchTaskPriority = 4;
+static constexpr BaseType_t kFetchTaskCore = 1;
+static constexpr uint32_t kRecognizeTaskStackSize = 4096;  // internal RAM; measured peak use ~1.5 KB (MN7 detect)
+static constexpr UBaseType_t kRecognizeTaskPriority = 1;
+static constexpr BaseType_t kRecognizeTaskCore = 0;
+static constexpr int kRecognizeYieldEveryChunks = 4;       // let IDLE0 run while catching up (task watchdog)
+static constexpr BaseType_t kAfeTaskCore = 1;
+static constexpr int kAfeTaskPriority = 5;
+static constexpr int64_t kSpeechTailUs = 400 * 1000;       // keep feeding MultiNet this long after VAD silence
+static constexpr size_t kMaxQueuedChunks = 94;             // ~3 s of 32 ms chunks: bounds the wake-up latency
+static constexpr size_t kTrimQueuedChunks = 40;            // on overflow keep only the newest ~1.3 s (hysteresis)
+static constexpr int64_t kLoadStatsPeriodUs = 60 * 1000 * 1000;
