+
+void CustomWakeWord::ReleaseEngines() {
+    // The AudioService may replace the wake word (e.g. after new assets are applied), and a failed Initialize()
+    // is retried: stop both tasks before the AFE and MultiNet they use are destroyed
+    EventBits_t wait_bits = 0;
+    if (fetch_task_ != nullptr) {
+        wait_bits |= FETCH_TASK_EXITED_EVENT;
+    }
+    if (recognize_task_ != nullptr) {
+        wait_bits |= RECOGNIZE_TASK_EXITED_EVENT;
+    }
+    if (wait_bits != 0) {
+        xEventGroupSetBits(event_group_, DETECTION_EXIT_EVENT);
+        xSemaphoreGive(speech_signal_);
+        // A MultiNet chunk in progress can take ~150 ms worst case
+        EventBits_t bits = xEventGroupWaitBits(event_group_, wait_bits, pdFALSE, pdTRUE, pdMS_TO_TICKS(3000));
+        if ((bits & wait_bits) != wait_bits) {
+            // A task may still be using the AFE/MultiNet: leaking them is the only safe option (EXIT stays set)
+            ESP_LOGE(TAG, "Wake word tasks did not exit in time, keeping their engines alive");
+            engines_leaked_ = true;
+            fetch_task_ = nullptr;
+            recognize_task_ = nullptr;
+            return;
+        }
+        fetch_task_ = nullptr;
+        recognize_task_ = nullptr;
+    }
+
+    if (afe_data_ != nullptr) {
+        afe_iface_->destroy(afe_data_);
+        afe_data_ = nullptr;
+    }
+
+    if (multinet_model_data_ != nullptr && multinet_ != nullptr) {
+        multinet_->destroy(multinet_model_data_);
+        multinet_model_data_ = nullptr;
+    }
+
+    // Only release the model list if it was loaded here; a list passed to Initialize() belongs to the caller
+    if (models_ != nullptr && owns_models_) {
         esp_srmodel_deinit(models_);
     }
+    models_ = nullptr;
+    owns_models_ = false;
+
+    ClearSpeechQueue();
+    pending_samples_.clear();
+    xEventGroupClearBits(event_group_, DETECTION_EXIT_EVENT | FETCH_TASK_EXITED_EVENT | RECOGNIZE_TASK_EXITED_EVENT);
 }
 
